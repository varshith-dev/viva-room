# PostgreSQL connection (Neon free tier works). On Vercel, the Neon integration sets this for you.
DATABASE_URL="postgresql://postgres:pw@localhost:5432/vivaroom"
# Any long random string. Signs the login cookie.
AUTH_SECRET="change-me"

# AI provider. All optional. Viva Room picks the first one that is set:
# 1. Google Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# 2. Groq (free key from https://console.groq.com/keys)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# 3. If neither is set, it uses the free keyless Pollinations text API (https://pollinations.ai).
